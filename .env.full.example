# ============================================================================
# YotCode 全量环境变量模板（项目内参考副本）
# ----------------------------------------------------------------------------
# 首次运行 yot 时，程序会自动在 ~/.yotcode/.env 生成同样的内容。
# 所有行默认注释；想启用哪项就删掉行首 # 并填值。
# 真实环境变量 > .env > settings.json 的 env 字段。
# 类别：anthropic（Claude 官方）/ openai（所有 OpenAI 兼容接口）。
# ============================================================================

# ---- A 类：Anthropic 官方 API（provider = anthropic）-----------------------
# ANTHROPIC_API_KEY=sk-ant-你的密钥
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=你的授权令牌

# ---- B 类：OpenAI 兼容接口（provider = openai）-----------------------------
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://api.openai.com/v1     # 自建服务/网关才需要
# DEEPSEEK_API_KEY=sk-你的密钥                  # 自动 baseUrl
# DASHSCOPE_API_KEY=sk-你的密钥                 # 通义千问，自动 baseUrl
# MOONSHOT_API_KEY=sk-你的密钥                  # Kimi，自动 baseUrl
# ZHIPUAI_API_KEY=你的密钥                      # 智谱 GLM，自动 baseUrl
# CCPY_API_KEY=sk-你的密钥                      # 通用 openai key（旧名）

# ---- 模型 / 供应商 / shell --------------------------------------------------
# CCPY_MODEL=claude-sonnet-4-5
# CCPY_PROVIDER=anthropic
# CCPY_SHELL=bash

# ---- 联网搜索 --------------------------------------------------------------
# BRAVE_API_KEY=你的密钥
# TAVILY_API_KEY=你的密钥

# ---- YotCode 高级选项 ------------------------------------------------------
# YOTCODE_HOME=~/.yotcode
# YOTCODE_SHELL=bash
# YOTCODE_FONT_SIZE=14
# YOTCODE_API_LOG=~/.yotcode/logs/api.log
