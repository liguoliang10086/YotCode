# ── Anthropic (Claude) ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── OpenAI compatible (DeepSeek / Qwen / Kimi / Ollama / vLLM ...) ──
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# DeepSeek shortcut (sets base URL automatically)
# DEEPSEEK_API_KEY=sk-...

# ── Optional web search providers ──────────────────────────────────
# BRAVE_API_KEY=...
# TAVILY_API_KEY=...

# ── YotCode options ───────────────────────────────────────────────
# CCPY_MODEL=claude-sonnet-4-5
# CCPY_PROVIDER=anthropic
# CCPY_SHELL=bash
