{
  // OpenAI 官方 API。Key 写在 .env：OPENAI_API_KEY=sk-...
  // 同时存在 ANTHROPIC_API_KEY 时，provider 必须显式写 openai。
  "model": "gpt-4.1",
  "provider": "openai",
  "maxTokens": 8192,
  "maxTurns": 60,
  "autoCompact": true,
  "providers": {
    "openai": {
      "baseUrl": "https://api.openai.com/v1"
    }
  }
}
